FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    RETROONE_MCP_HOST=0.0.0.0 RETROONE_MCP_PORT=8090
WORKDIR /opt/retroone
COPY requirements-mcp.txt ./
RUN pip install --no-cache-dir -r requirements-mcp.txt \
    && useradd --system --uid 10001 --no-create-home retroone-mcp
COPY retroone_mcp/ ./retroone_mcp/
USER 10001:10001
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/healthz', timeout=3).read()"
# In-memory leases require exactly one worker; request outcomes persist in /state.
CMD ["python", "-m", "retroone_mcp.server"]
