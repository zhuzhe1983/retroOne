#!/usr/bin/with-contenv bash
set -e
for gid in ${RETROONE_SUPPLEMENTARY_GIDS//,/ }; do
  [[ "$gid" =~ ^[0-9]+$ ]] || continue
  getent group "$gid" >/dev/null || groupadd -g "$gid" "retroone-host-$gid"
  usermod -aG "$gid" abc
done
mkdir -p /config/retroone/system /config/retroone/saves /config/retroone/work /config/retroone/logs /config/retroone/profile-control
mkdir -p "${RETROONE_ARTWORK_ROOT:-/artwork}"
chown abc:abc "${RETROONE_ARTWORK_ROOT:-/artwork}"
mkdir -p "${RETROONE_LIBRARY_DATA_ROOT:-/config/retroone/library-data}"
chown abc:abc "${RETROONE_LIBRARY_DATA_ROOT:-/config/retroone/library-data}"
cp -an /opt/retroone/system/. /config/retroone/system/
chown -R abc:abc /config/retroone
mkdir -p /config/.config/PCSX2/bios
chown -R abc:abc /config/.config/PCSX2
cp /opt/retroone/stream-input.js /usr/share/selkies/web/retroone-input.js
python3 - <<'PY'
from pathlib import Path
import hashlib
import re
p = Path('/usr/share/selkies/web/index.html')
s = p.read_text()
version = hashlib.sha256(p.with_name('retroone-input.js').read_bytes()).hexdigest()[:16]
tag = f'<script src="./retroone-input.js?v={version}"></script>'
pattern = r"""<script\b[^>]*\bsrc=["'](?:\./)?retroone-input\.js(?:\?[^"']*)?["'][^>]*>\s*</script>"""
if re.search(pattern, s):
    s = re.sub(pattern, lambda _: tag, s)
else:
    s = s.replace('<head>', '<head>' + tag, 1)
p.write_text(s)
PY
